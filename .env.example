# Database
DATABASE_URL=postgresql://vrtournament:vrtournament@localhost:15432/vrtournament

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite) — production builds REQUIRE a public API URL (no localhost)
# Local: VITE_API_URL=http://localhost:3000
# Prod:  VITE_API_URL=https://api.tournament.pixelpaddle.com
VITE_API_URL=http://localhost:3000
APP_URL=http://localhost:5173

# Email — tried in order: Resend → SMTP → SES; first one that accepts wins.
# With none configured, dev logs emails to the console and prod records them as failed.
# Resend only sends from a domain verified in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@pixelpaddle.com
# SMTP fallback (Google Workspace: smtp.gmail.com, 587, an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
NOTIFICATION_EMAIL_ENABLED=true

# Meta Quest integration
META_API_KEY=sample-meta-api-key-change-me

# Stripe (buyback lives only — required for buyback checkout in production)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# AWS SES
AWS_ACCESS_KEY_ID=sample-aws-access-key
AWS_SECRET_ACCESS_KEY=sample-aws-secret-key
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=notifications@pixelpaddle.com
